{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "inherits": "vcpkg",
      "environment": {
        "VCPKG_ROOT": "$penv{HOME}/vcpkg"
      }
    },
    {
      "name": "build-examples",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_EXAMPLES": "ON" ,
        "BUILD_VIZ": "ON",
        "BUILD_PERCEPTION": "ON"
      }
    }
  ]
  
}
