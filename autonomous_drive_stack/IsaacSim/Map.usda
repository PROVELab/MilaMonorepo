    def "CollisionGroups"
    {
        def PhysicsCollisionGroup "Cones"
        {
            prepend rel collection:colliders:includes = </ParkingLot/Cones>
            prepend rel physics:filteredGroups = </Mila/CollisionGroups/WheelGroundQuery>
        }
    }

    def "Lighting"
    {
        def DistantLight "Sun" (
            active = false
        )
        {
            float inputs:angle = 0.53
            color3f inputs:color = (1, 0.96, 0.9)
            float inputs:intensity = 3000
            float3 xformOp:rotateXYZ = (35, 0, 135)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DomeLight "Sky" (
            active = false
        )
        {
            color3f inputs:color = (0.62, 0.78, 1)
            float inputs:intensity = 800
        }
    }

    def "Materials"
    {
        def Material "Concrete"
        {
            token outputs:surface.connect = </ParkingLot/Materials/Concrete/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.44, 0.41)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

