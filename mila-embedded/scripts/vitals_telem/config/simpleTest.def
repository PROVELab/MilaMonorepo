#node Definitions
#Update the pedal to no longer be critical when pressed for final use. ts for testing rn

node: id=prechargeID, name=precharge, board=rust
CANFrame: frequency=100, dataTimeout=500
battery_V: bitLength=10, min=-100, max=923, minWarning=120, minCritical=80, startingValue=0
motor_V: bitLength=10, min=-100, max=923,  minWarning=120, minCritical=80, startingValue=0
prechargeState: enum=prechargeState, startingValue=prechargeState.Off
contactorState: enum=prechargeState, startingValue=prechargeState.Off
prechargeLatched: bitLength=1, min=0, max=1, startingValue=0



node: id=8, name=pedalSensor, board=esp
CANFrame: frequency=1000, dataTimeout=5000
pedalPowerReadingmV: bitLength=16, min=-30000, max=35000, minWarning=4700, maxWarning=7100, startingValue=6000
pedalReadingOne: bitLength=8, min=-20, max=120, minWarning=20, maxWarning=80, minCritical=5, maxCritical=95, startingValue=30
pedalReadingTwo: bitLength=8, min=-20, max=120, minWarning=20, maxWarning=80, minCritical=5, maxCritical=95, startingValue=30
brakeReading: bitLength=8, min=-20, max=120, minWarning=-10, maxWarning=110, startingValue=-1
SDIO_det_pin: bitLength=1, min=0, max=1, minWarning=0, startingValue=0


node: id=9, name=IMU, board=esp

CANFrame: frequency=100, dataTimeout=500, enableTelemCallback=true
IMU_temp_F: bitLength=10, min=-100, max=923, startingValue=67
radiator_temp_F: bitLength=10, min=-100, max=923, startingValue=67
humiditySense_temp_F: bitLength=10, min=-100, max=923, startingValue=67
RH: bitLength=8, min=-55, max=200, minWarning=0, maxWarning=100, startingValue=1

CANFrame: frequency=1000, dataTimeout=5000
posX_m: bitLength=21, min=-1048576, max=1048575, startingValue=0
posY_m: bitLength=21, min=-1048576, max=1048575, startingValue=0
posZ_m: bitLength=21, min=-1048576, max=1048575, startingValue=0

CANFrame: frequency=1000, dataTimeout=5000
accelY_mm_p_ss: bitLength=16, min=-32768, max=32767, startingValue=0
accelZ_mm_p_ss: bitLength=16, min=-32768, max=32767, startingValue=0
gyroX_deg_p_s: bitLength=8, min=-128, max=127, startingValue=0
gryoY_deg_p_s: bitLength=8, min=-128, max=127, startingValue=0
gyroZ_deg_p_s: bitLength=8, min=-128, max=127, startingValue=0



node: id=10, name=powerDistribution, board=esp
CANFrame: frequency=100, dataTimeout=500
LV_Battery_mV: bitLength=16, min=-22768, max=42767, startingValue=0
LV_Battery_mA: bitLength=16, min=-32768, max=32767, startingValue=0

CANFrame: frequency=200, dataTimeout=1000
CoolantPumpAvgCurrent_mA: bitLength=16, min=-32768, max=32767, startingValue=0
CoolantPumpPeakCurrent_mA: bitLength=16, min=-32768, max=32767, startingValue=0
CoolantPump_Freq_kHz: bitLength=8, min=0, max=255, startingValue=0
CoolantPumpDutyCycle: bitLength=7, min=0, max=100, startingValue=0
CoolantDriver_Fault: bitLength=1, min=0, max=1, startingValue=0




node: id=11, name=APSensorESP, board=esp
CANFrame: frequency=700, dataTimeout=1500
airPressure: bitLength=32, min=-2147483648, max=2147483647, minWarning=20, maxWarning=80, minCritical=5, maxCritical=95, startingValue=50
#airPressure: bitLength=32, min=-2147483648, max=2147483647, startingValue=2147483647