CompileFlags:
  Remove:
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -mlongcalls
    - -fno-shrink-wrap
  Add:
    # FreeRTOS core includes
    - -isystem/home/shynn/.platformio/packages/framework-espidf/components/freertos/include
    - -isystem/home/shynn/.platformio/packages/framework-espidf/components/freertos/FreeRTOS-Kernel/include

    # FreeRTOS Xtensa portable layer (THIS IS THE MISSING PIECE)
    - -isystem/home/shynn/.platformio/packages/framework-espidf/components/freertos/FreeRTOS-Kernel/portable/xtensa/include

    # Xtensa sysroot (machine/, sys/, stdint, etc.)
    - --sysroot=/home/shynn/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf

    # newlib headers (stdio.h, stdlib.h, etc.)
    - -isystem/home/shynn/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include

    # ESP-IDF newlib glue
    - -isystem/home/shynn/.platformio/packages/framework-espidf/components/newlib/include
    - -isystem/home/shynn/.platformio/packages/framework-espidf/components/newlib/platform_include

    # ESP-IDF core headers (this one matters)
    - -isystem/home/shynn/.platformio/packages/framework-espidf/components/esp_common/include
    - -isystem/home/shynn/.platformio/packages/framework-espidf/components/esp_system/include

Diagnostics:
  Suppress:
    - unused-includes
