{% for (_name, sub) in substructs %}
message {{ sub.alias|pascal }} {
{%- for (field_name, field) in sub.fields %}
{%- if field.kind.is_scalar() %}
  {{ field.kind|proto_scalar_type }} {{ field_name|proto_ident }} = {{ loop.index }};
{%- else %}
{%- match field.kind %}
{%- when FieldType::Enum { variants } %}
  message {{ field_name|pascal }}Value {
    oneof kind {
{%- for (variant_name, _payload) in variants %}
      {{ field_name|pascal }}{{ variant_name|pascal }} {{ variant_name|proto_ident }} = {{ loop.index }};
{%- endfor %}
    }
{%- for (variant_name, payload) in variants %}
    message {{ field_name|pascal }}{{ variant_name|pascal }} {
{%- for (payload_field_name, payload_kind) in payload.fields %}
      {{ payload_kind|proto_scalar_type }} {{ payload_field_name|proto_ident }} = {{ loop.index }};
{%- endfor %}
    }
{%- endfor %}
  }
  {{ field_name|pascal }}Value {{ field_name|proto_ident }} = {{ loop.index }};
{%- else %}
{%- endmatch %}
{%- endif %}
{%- endfor %}
}
{% endfor %}
message VehicleStatusRegister {
{%- for (name, sub) in substructs %}
  {{ sub.alias|pascal }} {{ name|proto_ident }} = {{ loop.index }};
{%- endfor %}
}
