/**
 * Autogenerated VSR state implementation.
 * Uses nanopb-generated vsr_VehicleStatusRegister encode.
 */

#include "vsr_state.h"

#include <string.h>

#include "pb_encode.h"

static void lock_all(vehicle_status_reg_t* vsr) {
#define VSR_LOCK_SLOT(name) xSemaphoreTake(vsr->name##_meta.mutex, portMAX_DELAY);
    VSR_SLOT_LIST(VSR_LOCK_SLOT)
#undef VSR_LOCK_SLOT
}

static void unlock_all(vehicle_status_reg_t* vsr) {
#define VSR_UNLOCK_SLOT(name) xSemaphoreGive(vsr->name##_meta.mutex);
    VSR_SLOT_LIST(VSR_UNLOCK_SLOT)
#undef VSR_UNLOCK_SLOT
}

int vsr_init(vehicle_status_reg_t* vsr) {
    if (vsr == NULL) {
        return -1;
    }

    memset(vsr, 0, sizeof(*vsr));
    vsr->wire = vsr_VehicleStatusRegister_init_zero;

#define VSR_INIT_SLOT(name)                 \
    do {                                    \
        vsr->name##_meta.mutex =            \
            xSemaphoreCreateMutex();        \
        vsr->name##_meta.updated_at_us = 0; \
    } while (0)
    VSR_SLOT_LIST(VSR_INIT_SLOT)
#undef VSR_INIT_SLOT

    return 0;
}

bool vsr_serialize(
    const vehicle_status_reg_t* vsr,
    uint8_t* out_buf,
    size_t out_capacity,
    size_t* out_len
) {
    if (vsr == NULL || out_buf == NULL || out_len == NULL) {
        return false;
    }

    vehicle_status_reg_t* mutable_vsr = (vehicle_status_reg_t*)vsr;
    lock_all(mutable_vsr);
    vsr_VehicleStatusRegister snapshot = mutable_vsr->wire;
    unlock_all(mutable_vsr);

    pb_ostream_t stream = pb_ostream_from_buffer(out_buf, out_capacity);
    if (!pb_encode(&stream, vsr_VehicleStatusRegister_fields, &snapshot)) {
        return false;
    }

    *out_len = stream.bytes_written;
    return true;
}
