/**
 * Autogenerated VSR state wrapper around nanopb wire structs.
 * Plain structs + helper macros + function declarations.
 */

#ifndef VSR_STATE_H
#define VSR_STATE_H

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#include "esp_timer.h"
#include "freertos/FreeRTOS.h"
#include "freertos/semphr.h"
#include "vsr.pb.h" // Generated by nanopb from generated/vsr.proto

#ifdef __cplusplus
extern "C" {
#endif

typedef struct {
    SemaphoreHandle_t mutex;
    int64_t updated_at_us;
} vsr_slot_meta_t;

#define VSR_SLOT_LIST(X) \
{%- for (name, _sub) in substructs %}
    X({{ name }}) \
{%- endfor %}
    /* end */

typedef struct {
    // Full wire-compatible payload.
    vsr_VehicleStatusRegister wire;

    // One lock/timestamp per top-level VSR section.
#define VSR_DECLARE_SLOT_META(name) vsr_slot_meta_t name##_meta;
    VSR_SLOT_LIST(VSR_DECLARE_SLOT_META)
#undef VSR_DECLARE_SLOT_META
} vehicle_status_reg_t;

/**
 * Shorthand for code paths where the local pointer variable is named `vsr`.
 * Example: `VSR.motor_control.current_reference = 10;`
 */
#define VSR (vsr->wire)

/**
 * Lock one slot for read access (no timestamp update).
 * Example: VSR_SLOT_READ(vsr, motor_control, { copy = vsr->wire.motor_control; });
 */
#define VSR_SLOT_READ(vsr_ptr, slot_name, body)                     \
    do {                                                             \
        xSemaphoreTake((vsr_ptr)->slot_name##_meta.mutex,           \
                       portMAX_DELAY);                               \
        body                                                         \
        xSemaphoreGive((vsr_ptr)->slot_name##_meta.mutex);          \
    } while (0)

/**
 * Lock one slot for write access (updates per-slot timestamp).
 * Example: VSR_SLOT_WRITE(vsr, motor_control, { vsr->wire.motor_control = v; });
 */
#define VSR_SLOT_WRITE(vsr_ptr, slot_name, body)                     \
    do {                                                             \
        xSemaphoreTake((vsr_ptr)->slot_name##_meta.mutex,           \
                       portMAX_DELAY);                               \
        body                                                         \
        (vsr_ptr)->slot_name##_meta.updated_at_us =                 \
            esp_timer_get_time();                                    \
        xSemaphoreGive((vsr_ptr)->slot_name##_meta.mutex);          \
    } while (0)

int vsr_init(vehicle_status_reg_t* vsr);

bool vsr_serialize(
    const vehicle_status_reg_t* vsr,
    uint8_t* out_buf,
    size_t out_capacity,
    size_t* out_len
);

#ifdef __cplusplus
}
#endif

#endif // VSR_STATE_H
