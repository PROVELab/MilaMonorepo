/**
 * Autogenerated VSR print helpers.
 * Per-topic print functions are file-local.
 * TODO: enum fields are skipped for now.
 */

#include "vsr_state.h"

#include <stdio.h>
#include <string.h>

#include "esp_timer.h"

typedef void (*vsr_topic_printer_fn)(const vehicle_status_reg_t* vsr);

typedef struct {
    const char* topic_name;
    vsr_topic_printer_fn print;
} vsr_topic_printer_t;

static void print_timestamp_info(const char* indent, int64_t timestamp_us) {
    int64_t age_ms = 0;
    if (timestamp_us > 0) {
        const int64_t now_us = esp_timer_get_time();
        if (now_us > timestamp_us) {
            age_ms = (now_us - timestamp_us) / 1000;
        }
    }
    const char* note = timestamp_us > 0 ? "" : ", not updated yet";
    printf("%stimestamp: %lld us (%lld ms ago%s)\n",
           indent,
           (long long)timestamp_us,
           (long long)age_ms,
           note);
}

{% for slot in slots %}static void print_{{ slot.name }}(const vehicle_status_reg_t* vsr) {
    int64_t timestamp_us = 0;
    {{ slot.wire_type }} slot;
    memset(&slot, 0, sizeof(slot));

    ACQ_REL_VSRSEM_R(vsr, {{ slot.name }}, {
        timestamp_us = vsr->{{ slot.name }}_updated_at_us;
        slot = vsr->wire.{{ slot.name }};
    });

    printf("{{ slot.topic_name_escaped }}:\n");
    print_timestamp_info("  ", timestamp_us);
{% for print_line in slot.scalar_print_lines %}{{ print_line }}
{% endfor %}{% for field_name in slot.skipped_enum_fields %}    /* TODO: enum field '{{ field_name }}' print is skipped for now. */
{% endfor %}}{% if !loop.last %}

{% endif %}{% endfor %}
static const vsr_topic_printer_t k_topics[] = {
{% for slot in slots %}    {.topic_name = "{{ slot.topic_name_escaped }}", .print = &print_{{ slot.name }}},
{% endfor %}};

static const size_t k_topic_count = sizeof(k_topics) / sizeof(k_topics[0]);

void print_available_topics_internal(void) {
    printf("available topics:\n");
    for (size_t i = 0; i < k_topic_count; ++i) {
        printf("  %s\n", k_topics[i].topic_name);
    }
}

void vsr_print_topic(const char* topic_name, const vehicle_status_reg_t* vsr) {
    if (topic_name == NULL || vsr == NULL) {
        return;
    }

    if (strcmp(topic_name, "all") == 0) {
        for (size_t i = 0; i < k_topic_count; ++i) {
            k_topics[i].print(vsr);
            if (i + 1 < k_topic_count) {
                puts("");
            }
        }
        return;
    }

    for (size_t i = 0; i < k_topic_count; ++i) {
        if (strcmp(k_topics[i].topic_name, topic_name) == 0) {
            k_topics[i].print(vsr);
            return;
        }
    }

    printf("unknown topic '%s'\n", topic_name);
    print_available_topics_internal();
}
